PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/finvault?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Seeded admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@finvault.com
ADMIN_PASSWORD=change-me-immediately
